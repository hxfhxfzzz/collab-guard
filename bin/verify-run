#!/usr/bin/env python3
"""verify-run：包一层再跑测试命令，把「验证」的三条规则固化成退出码。

用法：
  verify-run --report '<报告通配符>' [--report …] [--cwd 目录] -- <测试命令…>

  --report   JUnit XML 报告的通配符，相对 --cwd，支持 **。必填，可以写多个。
             pytest --junitxml、Maven Surefire、Gradle、jest-junit、go-junit-report 等都能出这种报告。
  --cwd      在哪个目录跑，默认当前目录。

例子：
  verify-run --report 'reports/junit.xml' -- pytest --junitxml=reports/junit.xml
  verify-run --report 'target/surefire-reports/TEST-*.xml' -- mvn -q test -Dtest=FooTest

三条规则：
  1. 只认本次运行生成的证据。运行前就在、运行后没变的报告不算；
     运行期间工作区的源码被改了（比如另一个会话在改），结果作废，要重跑。
  2. 0 个用例不算通过。按报告里实际执行的用例数算，全部跳过也算 0；没有本次生成的报告同样算 0。
  3. 跑不了就是「未验证」，不写成通过。命令不存在、参数不对，退出码是 2，不是 0。

退出码：0 通过；1 不通过；2 未验证（参数或环境问题）。
写交付说明时照退出码写：1 写「不通过」，2 写「未验证」并说明原因，不要写成「已通过」。
"""
import argparse
import glob
import os
import subprocess
import sys
import xml.etree.ElementTree as ET

PASS, FAIL, UNVERIFIED = 0, 1, 2


def say(text):
    print("【验证】" + text, flush=True)


def unverified(reason):
    say("结论：未验证 ⚠️  %s" % reason)
    sys.exit(UNVERIFIED)


def stat_of(path):
    try:
        st = os.stat(path)
        return (st.st_mtime_ns, st.st_size)
    except OSError:
        return None


def report_files(cwd, patterns):
    """{绝对路径: (修改时间, 大小)}"""
    found = {}
    for pattern in patterns:
        for path in glob.glob(os.path.join(cwd, pattern), recursive=True):
            if os.path.isfile(path):
                found[os.path.realpath(path)] = stat_of(path)
    return found


def git(cwd, *args):
    return subprocess.run(["git", "--no-optional-locks", "-c", "core.quotePath=false", "-C", cwd, *args],
                          capture_output=True, text=True)


def source_state(cwd):
    """工作区源码的快照：{绝对路径: (状态, 修改时间, 大小)}，外加 HEAD。不是 git 仓库返回 None。"""
    top = git(cwd, "rev-parse", "--show-toplevel")
    if top.returncode != 0:
        return None
    root = top.stdout.strip()
    head = git(cwd, "rev-parse", "--verify", "-q", "HEAD").stdout.strip()
    state = {"HEAD": (head, None, None)}
    entries = git(cwd, "status", "--porcelain=v1", "-uall", "-z").stdout.split("\0")
    i = 0
    while i < len(entries):
        entry = entries[i]
        i += 1
        if len(entry) < 4:
            continue
        status, path = entry[:2], entry[3:]
        if status[0] in "RC":  # 改名和复制后面还跟着一个原路径
            i += 1
        full = os.path.realpath(os.path.join(root, path))
        state[full] = (status,) + (stat_of(full) or (None, None))
    return state


def changed_sources(before, after, reports):
    paths = set(before) | set(after)
    return sorted(p for p in paths if p not in reports and before.get(p) != after.get(p))


def count(path):
    """一份报告里的 (用例, 失败, 错误, 跳过)。读不了返回 None。"""
    try:
        root = ET.parse(path).getroot()
    except (ET.ParseError, OSError):
        return None
    cases = list(root.iter("testcase"))
    if cases:
        def has(tag):
            return sum(1 for case in cases if case.find(tag) is not None)
        return len(cases), has("failure"), has("error"), has("skipped")
    # 没有逐条用例的报告：取最里层 testsuite 的属性
    suites = [s for s in root.iter("testsuite") if s.find("testsuite") is None]

    def attr(name):
        total = 0
        for suite in suites:
            try:
                total += int(float(suite.get(name) or 0))
            except ValueError:
                pass
        return total
    return attr("tests"), attr("failures"), attr("errors"), attr("skipped")


def main():
    argv = sys.argv[1:]
    split = argv.index("--") if "--" in argv else len(argv)
    options, command = argv[:split], argv[split + 1:]
    ap = argparse.ArgumentParser(usage="verify-run --report '<报告通配符>' [--cwd 目录] -- <测试命令…>")
    ap.add_argument("--report", action="append", default=[])
    ap.add_argument("--cwd", default=".")
    try:
        args = ap.parse_args(options)
    except SystemExit as exc:
        sys.exit(0 if exc.code == 0 else UNVERIFIED)
    cwd = os.path.realpath(args.cwd)
    if not os.path.isdir(cwd):
        unverified("目录不存在：%s" % args.cwd)
    if not args.report:
        unverified("没写 --report。没有报告就数不了用例，不能判通过。")
    if not command:
        unverified("没写要跑的测试命令（写在 -- 后面）。")

    reports_before = report_files(cwd, args.report)
    source_before = source_state(cwd)
    say("运行：%s" % " ".join(command))
    try:
        returncode = subprocess.run(command, cwd=cwd).returncode
    except (FileNotFoundError, PermissionError, NotADirectoryError) as exc:
        unverified("命令跑不起来：%s" % exc)
    if returncode in (126, 127):
        unverified("命令跑不起来（退出码 %d：找不到命令或没有执行权限）。" % returncode)
    reports_after = report_files(cwd, args.report)
    source_after = source_state(cwd)

    fresh = sorted(p for p, st in reports_after.items() if reports_before.get(p) != st)
    stale = len(reports_after) - len(fresh)
    tests = failures = errors = skipped = 0
    broken = []
    for path in fresh:
        counted = count(path)
        if counted is None:
            broken.append(os.path.relpath(path, cwd))
            continue
        tests, failures, errors, skipped = (a + b for a, b in zip((tests, failures, errors, skipped), counted))
    executed = tests - skipped

    say("本次生成的报告 %d 份%s；用例 %d，执行 %d，失败 %d，错误 %d，跳过 %d；命令退出码 %d" % (
        len(fresh), "（另有 %d 份是旧的，不算）" % stale if stale else "",
        tests, executed, failures, errors, skipped, returncode))

    problems = []
    if source_before is None or source_after is None:
        say("注意：这里不是 git 仓库，没法检查运行期间源码有没有被改。")
    else:
        changed = changed_sources(source_before, source_after, set(reports_before) | set(reports_after))
        if changed:
            shown = "、".join(os.path.relpath(p, cwd) if p != "HEAD" else "HEAD" for p in changed[:5])
            problems.append("运行期间源码被改了（%s%s），结果作废，重跑" % (shown, " 等 %d 处" % len(changed) if len(changed) > 5 else ""))
    if broken:
        problems.append("报告读不了：%s" % "、".join(broken[:5]))
    if not fresh:
        problems.append("没有本次运行生成的报告")
    elif executed <= 0:
        problems.append("实际执行的用例是 0 个")
    if failures or errors:
        problems.append("有 %d 个失败、%d 个错误" % (failures, errors))
    if returncode != 0:
        problems.append("命令退出码是 %d" % returncode)

    if problems:
        say("结论：不通过 ❌  %s" % "；".join(problems))
        return FAIL
    say("结论：通过 ✅  %d 个用例实际执行，全部通过" % executed)
    return PASS


if __name__ == "__main__":
    sys.exit(main())
